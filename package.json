{
  "name": "cloudnine",
  "version": "0.1.0",
  "private": true,
  "description": "CloudNine — Win11 风格云服务器桌面（自托管单用户）",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start",
    "test": "node scripts/run-tests.mjs",
    "test:core": "node scripts/run-tests.mjs --group=core",
    "test:plugin": "node scripts/run-tests.mjs --group=plugin",
    "test:fast": "node scripts/run-tests.mjs --only=core,dev-plugin,openwith"
  }
}
